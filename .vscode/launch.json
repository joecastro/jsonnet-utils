{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Tests (npm)",
      "type": "node",
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {

      },
      "internalConsoleOptions": "neverOpen",
      "request": "launch",
      "runtimeArgs": [
        "test"
      ],
      "runtimeExecutable": "npm",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
