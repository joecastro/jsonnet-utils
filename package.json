{
  "name": "jsonnet-utils",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "bootstrap": "python3 scripts/bootstrap_config.py",
    "bootstrap:check": "python3 scripts/bootstrap_config.py --check",
    "format:jsonnet": "find . -type f \\( -name '*.jsonnet' -o -name '*.libsonnet' \\) -not -path './node_modules/*' -not -path './out/*' -not -path './.git/*' -exec jsonnetfmt -i {} +",
    "lint": "eslint .",
    "lint:fix": "find . -type f \\( -name '*.jsonnet' -o -name '*.libsonnet' \\) -not -path './node_modules/*' -not -path './out/*' -not -path './.git/*' -exec jsonnetfmt -i {} + && eslint . --fix",
    "publish": "rm -rf dist && mkdir -p dist && find src -maxdepth 1 -type f \\( -name '*.jsonnet' -o -name '*.libsonnet' \\) -exec cp {} dist/ \\;",
    "test": "mocha \"test/**/*.spec.js\"",
    "update:versions": "python3 scripts/update_versions.py"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "mocha": "^11.7.5"
  },
  "description": "Reusable Jsonnet helpers and utilities",
  "license": "UNLICENSED"
}
